DATABASE_URL=postgresql://compliance_user:compliance_password@127.0.0.1:5432/compliance_platform
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_SMALL_MODEL=gemma3:270m
OLLAMA_LARGE_MODEL=gemma3:4b
OLLAMA_CONTEXT_WINDOW=2048
OLLAMA_MAX_INPUT_TOKENS=1400
OLLAMA_MAX_OUTPUT_TOKENS=512
OLLAMA_TIMEOUT_SECONDS=90
PROJECT_DOCS_ROOT=/home/ashwin/inovaare_1/revamped_KB/docs
# Optional read-only fine-grained token used only by configured GitHub connectors.
PROJECT_GITHUB_TOKEN=
# Optional Confluence Cloud API token. Configure its environment-variable name
# on a resource together with the Atlassian account email; never store the token.
PROJECT_CONFLUENCE_TOKEN=
